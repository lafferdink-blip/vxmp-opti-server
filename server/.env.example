# Variables d'environnement du serveur VXMP Opti
# Copie ce fichier en .env et complète les valeurs (ne jamais partager le .env)

# Base de données Postgres (Neon, gratuit) — ex: postgres://user:pass@ep-xxx.eu-central-1.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# Token du bot Discord (à mettre aussi sur Render)
DISCORD_BOT_TOKEN=

# Identifiant Discord du propriétaire (accès gratuit à vie)
OWNER_DISCORD_ID=1217205232484749494

# Token admin pour les routes /api/admin/*
ADMIN_TOKEN=change-me

# Lien de téléchargement de l'app (Google Drive, etc.)
DOWNLOAD_URL=

# URL publique de l'API (sur Render : https://vxmp-opti.onrender.com)
API_BASE_URL=http://localhost:4000

# Préfixe des clés + limites
KEY_PREFIX=BOOST
MAX_DEVICES=2
ALLOWED_REBINDS=3

# OAuth Discord réel (optionnel, sinon mode test) — à créer sur https://discord.com/developers
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Stripe (optionnel, paiement sur le site — sinon ventes via tickets Discord)
STRIPE_SECRET_KEY=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_LIFETIME=
STRIPE_WEBHOOK_SECRET=