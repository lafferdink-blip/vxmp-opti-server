# --- Serveur ---
PORT=4000
API_BASE_URL=http://localhost:4000

# --- Clés ---
# Format de clé : BOOST-XXXX-XXXX-XXXX-XXXX
KEY_PREFIX=BOOST

# --- Stripe (paiement) ---
# Laisse vide pour activer le "mode test" (la clé est générée immédiatement sans passer par Stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=price_xxx
STRIPE_PRICE_LIFETIME=price_xxx

# --- Licence ---
# Nombre max d'appareils simultanés par clé
MAX_DEVICES=2
# Nombre de ré-associations matérielles autorisées (changement de PC)
ALLOWED_REBINDS=3
# Durée de vie de la licence mensuelle (en jours)
MONTHLY_DAYS=30

# --- Admin (API interne pour générer des clés) ---
ADMIN_TOKEN=change-me

# --- Discord (vérification de l'app) ---
# OAuth Discord pour la connexion depuis l'app
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# ID du serveur Discord où le bot doit trouver l'utilisateur (vide = n'importe quel serveur du bot)
DISCORD_GUILD_ID=
# Lien d'invitation affiché à l'utilisateur s'il n'est pas membre du serveur
DISCORD_INVITE_URL=